generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  password      String
  role          Role
  createdAt     DateTime       @default(now())
  products      Product[]
  traces        Trace[]
  notifications Notification[]
  scanEvents    ScanEvent[]
}

model Product {
  id String @id @default(cuid())

  // Basic product information
  productName     String
  category        String    @default("GENERAL")
  brand           String?
  variant         String?
  productCode     String?   @unique
  barcode         String?   @unique
  batchNumber     String    @unique
  description     String?
  netQuantity     Decimal?  @db.Decimal(18, 3)
  unitOfMeasure   String?
  countryOfOrigin String?
  expiryDate      DateTime?
  attributes      Json?

  // QR / verification
  qrCode  String  @unique
  qrImage String?

  // Current state
  status ProductStatus

  // Supply-chain information
  rawMaterialSource String?
  supplier          String?
  processingPlant   String?
  processingDate    DateTime?

  // Quality & packaging
  qualityCheck  String?
  packagingUnit String?
  packagingDate DateTime?

  // Logistics
  warehouse    String?
  distributor  String?
  retailer     String?
  location     String?
  dispatchDate DateTime?
  deliveryDate DateTime?

  // Environmental information
  temperature Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  manufacturerId String
  manufacturer   User           @relation(fields: [manufacturerId], references: [id])
  traces         Trace[]
  notifications  Notification[]
  scanEvents     ScanEvent[]

  @@index([category])
  @@index([status])
  @@index([createdAt])
  @@index([manufacturerId, createdAt])
}

model Trace {
  id String @id @default(cuid())

  // Journey stage
  stage String

  // Location
  location  String
  latitude  Float?
  longitude Float?

  // Event information
  eventDate   DateTime?
  temperature Float?
  remarks     String?

  createdAt DateTime @default(now())

  // Relationships
  productId   String
  updatedById String

  product   Product @relation(fields: [productId], references: [id])
  updatedBy User    @relation(fields: [updatedById], references: [id])

  @@index([productId, eventDate])
  @@index([updatedById])
}

model Notification {
  id        String    @id @default(cuid())
  type      String
  severity  String    @default("INFO")
  title     String
  message   String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  userId    String
  productId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([productId])
}

model ScanEvent {
  id               String   @id @default(cuid())
  clientEventId    String?  @unique
  scannedValueHash String
  result           String
  isSuspicious     Boolean  @default(false)
  suspiciousReason String?
  latitude         Float?
  longitude        Float?
  deviceId         String?
  networkStatus    String   @default("ONLINE")
  scannedAt        DateTime
  createdAt        DateTime @default(now())

  userId    String
  productId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId, scannedAt])
  @@index([productId, scannedAt])
  @@index([isSuspicious, createdAt])
}

enum Role {
  MANUFACTURER
  SUPPLIER
  WAREHOUSE
  DISTRIBUTOR
  RETAILER
  CUSTOMER
}

enum ProductStatus {
  CREATED
  QUALITY_CHECK
  MANUFACTURED
  PACKAGED
  WAREHOUSE
  DISTRIBUTED
  RETAIL
  IN_TRANSIT
  DELIVERED
  SOLD
}
