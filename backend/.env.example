DATABASE_URL="postgresql://postgres:password@localhost:5432/tracechain"
JWT_SECRET="replace-with-a-cryptographically-random-secret-of-at-least-32-characters"
NODE_ENV="development"
PORT=5001
# Set this to the deployed site URL so generated QR codes open outside your LAN.
PUBLIC_BASE_URL="http://localhost:5001"
# Comma-separated browser origins. Mobile apps do not send a browser Origin header.
CORS_ORIGINS="http://localhost:5001"
# Set true only when running behind a trusted reverse proxy/load balancer.
TRUST_PROXY="false"
# Render supplies RENDER_EXTERNAL_URL automatically. Do not set it locally.
